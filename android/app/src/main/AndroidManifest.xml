<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lecture du code-barres d'une carte de fidelite. L'appareil photo n'est ouvert que sur
         demande explicite, et l'application reste utilisable sans : le code peut etre saisi. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Rappel de la date limite d'une liste. Demandee seulement quand une date est posee, et
         refusable : la date reste enregistree et affichee, c'est le rappel seul qui manque. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Micro, pour le mode mains libres de « Suivre la recette ». Le greffon de reconnaissance
         vocale declare RECORD_AUDIO ; il n est demande qu au premier « Mains libres », apres une
         explication, et les boutons restent utilisables sans. La requete ci-dessous rend le
         service de reconnaissance du telephone visible depuis Android 11. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Position, pour proposer la carte de fidelite a l approche d un magasin enregistre.
         Demandee seulement quand on active le reglage, qui part eteint, et coupable a tout
         moment. La precision grossiere suffit : le rayon de declenchement est de 300 m. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- ACCESS_BACKGROUND_LOCATION n est volontairement pas declaree. La tenir demanderait un
         service de premier plan, avec sa notification permanente et sa justification aupres du
         Play Store, pour une fonctionnalite de confort. La veille vit donc avec l application :
         ouverte ou recemment mise en arriere-plan, la position arrive ; une fois l application
         fermee par le systeme, plus rien ne tourne. L interface annonce exactement cela. -->

    <!-- Le greffon de notifications locales la declare, l'application ne s'en sert pas : ses
         rappels sont programmes en alarme inexacte, a la minute pres, ce qui suffit largement
         pour des courses. La garder obligerait a la justifier aupres du Play Store pour une
         precision dont on n'a pas besoin. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
</manifest>
