# Where your database is, and the key the browser uses to reach it. Both are public by construction: they
# ship in what the browser downloads anyway, and it is the RLS policies that protect the data, not their
# secrecy. Leave them empty and the app will say so rather than fail silently.
#
# From supabase.com: Project settings, API, "Project URL" and the "anon public" key.
# From a local stack (`pnpm db:start`): the CLI prints both when it finishes starting.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Optional: forwards crashes to your own Sentry project, in addition to the built-in `client_errors`
# table. Leave empty and nothing changes — no second sink, no extra network call. Every other instance
# is unaffected either way, since this is read per-instance from config.js, not baked into the image.
PUBLIC_SENTRY_DSN=

# Port the app is served on by `docker compose up`.
PORT=8080
