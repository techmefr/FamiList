<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Kept outside `ios/`, which is never committed (see the note next to it in .gitignore): `cap add ios`
	regenerates that whole directory fresh on every CI run, so nothing placed inside it would survive
	past the step that creates it.
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>REPLACE_WITH_APPLE_TEAM_ID</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>fr.techmefr.familist</key>
		<string>familist</string>
	</dict>
</dict>
</plist>
